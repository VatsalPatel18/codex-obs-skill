#!/home/prime/.local/share/uv/tools/obs-mcp/bin/python
"""Open the existing PS5 source on the external display."""

import fcntl
import os
import shutil
import socket
import subprocess
import sys
import time
import tomllib
from pathlib import Path

import obsws_python
from obsws_python.error import OBSSDKRequestError


def wait_for_obs(host, port):
    def listening():
        try:
            with socket.create_connection((host, port), timeout=0.3):
                return True
        except OSError:
            return False

    if listening():
        return
    if host not in {"localhost", "127.0.0.1", "::1"}:
        raise RuntimeError("The configured OBS WebSocket server is unavailable.")

    obs_running = subprocess.run(["pgrep", "-x", "obs"], stdout=subprocess.DEVNULL).returncode == 0
    if not obs_running:
        obs = shutil.which("obs-studio") or shutil.which("obs")
        if obs is None:
            raise RuntimeError("Could not find the OBS Studio executable.")
        subprocess.Popen(
            [obs, "--collection", "PS5", "--disable-missing-files-check"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )

    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        if listening():
            return
        time.sleep(0.25)
    raise RuntimeError("OBS WebSocket did not become available. Check OBS startup and Tools → WebSocket Server Settings.")


def open_projector():
    card = Path("/dev/v4l/by-id/usb-MACROSILICON_2109-video-index0")
    if not card.exists():
        raise RuntimeError("Connect the PS5 USB capture card first.")

    with (Path.home() / ".codex/config.toml").open("rb") as config:
        settings = tomllib.load(config)["mcp_servers"]["obs"].get("env", {})
    host = settings.get("OBS_HOST", "127.0.0.1")
    port = int(settings.get("OBS_PORT", "4455"))
    wait_for_obs(host, port)
    try:
        client = obsws_python.ReqClient(
            host=host,
            port=port,
            password=settings.get("OBS_PASSWORD", ""),
            timeout=3,
        )
    except Exception:
        raise RuntimeError("Could not sign in to OBS WebSocket. Check the OBS connection settings.") from None

    try:
        deadline = time.monotonic() + 10
        while True:
            try:
                monitors = client.send("GetMonitorList", raw=True)["monitors"]
                inputs = client.send("GetInputList", raw=True)["inputs"]
            except OBSSDKRequestError as error:
                if error.code != 207:
                    raise
                if time.monotonic() >= deadline:
                    raise RuntimeError("OBS is still starting up. Check its window for any startup prompts.") from None
            else:
                if any(item["inputName"] == "PS5 HDMI" for item in inputs):
                    break
                if time.monotonic() >= deadline:
                    raise RuntimeError("Select the PS5 scene collection in OBS first.")
            time.sleep(0.25)

        external = next(
            (item for item in monitors if item["monitorName"].split("(")[0] == "HDMI-1"),
            None,
        )
        if external is None:
            raise RuntimeError("Connect the external HDMI monitor first.")
        client.send("OpenSourceProjector", {
            "sourceName": "PS5 HDMI",
            "monitorIndex": external["monitorIndex"],
        })
    finally:
        client.disconnect()


if __name__ == "__main__":
    try:
        lock_path = Path(os.environ["XDG_RUNTIME_DIR"]) / "ps5-screen.lock"
        with lock_path.open("a") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise SystemExit(0) from None
            open_projector()
    except Exception as error:
        message = str(error) if isinstance(error, RuntimeError) else "Could not open the PS5 preview in OBS."
        print(message, file=sys.stderr)
        subprocess.run(["notify-send", "PS5 Screen", message], check=False)
        raise SystemExit(1)
